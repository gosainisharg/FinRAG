# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#   cp .env.example .env

# ---------------------------------------------------------------- credentials
# Both are PAID — no free tier. Prepaid credits, ~$5 minimum each.
# A ChatGPT Plus or Claude Pro subscription does NOT grant API access.
# Leave either blank to run without that provider; FinRAG will say so clearly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith has a usable free tier. Leave blank to run without tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
FINRAG_LANGSMITH_PROJECT=finrag

# ---------------------------------------------------------------- models
# Format: provider:model   (providers: openai | anthropic | llama)
# `llama` is the open-weight model, served locally by the Ollama runtime — free, unlimited.
#
# Routing/grading/rewriting are high-volume classification calls: use a small, cheap model.
# Generation wants the strongest model you have.
FINRAG_ROUTER_MODEL=openai:gpt-4o-mini
FINRAG_GRADER_MODEL=openai:gpt-4o-mini
FINRAG_REWRITER_MODEL=openai:gpt-4o-mini
FINRAG_GENERATOR_MODEL=anthropic:claude-sonnet-5

# Keep the judge in a DIFFERENT model family than the generator. A model scoring its own
# output rates it more highly than a neutral judge does.
FINRAG_JUDGE_MODEL=openai:gpt-4o

# To develop for free against a local model, point roles at llama, e.g.:
#   FINRAG_ROUTER_MODEL=llama:llama3.2
#   FINRAG_GENERATOR_MODEL=llama:llama3.2
FINRAG_OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------- retrieval
FINRAG_RETRIEVAL_K=20
FINRAG_RERANK_TOP_N=5
FINRAG_HYBRID_DENSE_WEIGHT=0.5

# ---------------------------------------------------------------- graph
FINRAG_MAX_RETRIEVAL_ATTEMPTS=2

# ---------------------------------------------------------------- cache
FINRAG_CACHE_ENABLED=true
FINRAG_CACHE_SIMILARITY_THRESHOLD=0.95

# ---------------------------------------------------------------- observability
FINRAG_PHOENIX_ENABLED=false
FINRAG_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# ---------------------------------------------------------------- serving
FINRAG_API_PORT=8000
